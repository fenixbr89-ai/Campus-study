# Campus Study V1 - backend configuration
MONGO_URL=mongodb://mongo:27017
DB_NAME=campus_study
CORS_ORIGINS=http://localhost,http://localhost:3000
# Public frontend origin used in password-reset links and future payment redirects
PUBLIC_APP_URL=http://localhost:3000
SUPPORT_EMAIL=suporte@campusstudy.com
COOKIE_SECURE=false
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
CPF_PEPPER=REPLACE_WITH_ANOTHER_LONG_RANDOM_SECRET
APP_TZ=America/Sao_Paulo
TERMS_VERSION=1.0
PRIVACY_VERSION=1.0


# Password-reset email: resend or smtp
EMAIL_PROVIDER=none
EMAIL_FROM_NAME=Campus Study
EMAIL_FROM_ADDRESS=
EMAIL_REPLY_TO=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# First administrator created by `python seed.py`
ADMIN_NAME=Administrador Campus Study
ADMIN_EMAIL=
ADMIN_CPF=
ADMIN_PASSWORD=

# Campus IA — desempenho, geração de imagens e anexos
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.7-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
AI_REQUEST_TIMEOUT=18
AI_MAX_RETRIES=1
AI_MAX_OUTPUT_TOKENS=768
